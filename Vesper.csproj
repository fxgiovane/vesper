<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Vesper</AssemblyName>
    <RootNamespace>Vesper</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Metadados de Autoria e Copyright -->
    <Product>VESPER</Product>
    <Title>VESPER</Title>
    <Description>Telemetria e Diagnostico de Armazenamento</Description>
    <Company>@_fxgiovane</Company>
    <Authors>@_fxgiovane</Authors>
    <Copyright>Copyright © 2026 @_fxgiovane. Todos os direitos reservados.</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0 @_fxgiovane</InformationalVersion>

    <!-- Build Auto-Contido e Executavel Unico -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Icone e Manifesto Admin -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="Exists('tools')">
    <EmbeddedResource Include="tools\*.exe" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.Management" Version="10.0.13" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

</Project>
